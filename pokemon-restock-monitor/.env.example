# Copia este archivo a ".env" y rellena solo los canales que quieras usar.
#   cp .env.example .env
#
# El archivo .env está en .gitignore: NUNCA subas tus tokens al repositorio.

# --- Telegram (recomendado: push a tu teléfono) ---
# 1) En Telegram, escribe a @BotFather y crea un bot con /newbot. Te da el token.
# 2) Escríbele algo a tu nuevo bot (para que pueda contestarte).
# 3) Obtén tu chat_id: escribe a @userinfobot, o abre
#    https://api.telegram.org/bot<TU_TOKEN>/getUpdates y busca "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (opcional) ---
# En tu servidor: Ajustes del canal > Integraciones > Webhooks > Nuevo webhook > Copiar URL.
DISCORD_WEBHOOK_URL=
